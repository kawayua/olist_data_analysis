POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
# If your machine already has a local Docker volume, override this in an uncommitted .env; do not commit that override.
POSTGRES_VOLUME_NAME=data_analysis_postgres_data

# 填写任意 OpenAI-compatible 服务的地址、密钥和模型名；不要提交 .env。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
